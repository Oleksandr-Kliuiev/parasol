root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,bicep,bicepparam,ts,tsx,js,css,html,md}]
indent_size = 2

# EF Core migrations are generated code
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
