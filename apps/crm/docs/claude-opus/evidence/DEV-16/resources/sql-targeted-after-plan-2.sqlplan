<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4275.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="(@from date,@to date)SELECT TOP(2) COUNT(*) AS [Count], COALESCE(SUM([t0].[Hours]), 0.0) AS [Hours], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Billable] = CAST(1 AS bit) THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Billable], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Status] IN (N'Approved', N'Invoiced') THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Approved], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Status] = N'New' THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [New], COALESCE(SUM(COALESCE([t0].[Amount], 0.0)), 0.0) AS [Amount]&#x0A;FROM (&#x0A;    SELECT [t].[Amount], [t].[Billable], [t].[Hours], [t].[Status], 1 AS [Key]&#x0A;    FROM [time].[TimeEntries] AS [t]&#x0A;    WHERE [t].[IsDeleted] = CAST(0 AS bit) AND [t].[WorkDate] &gt;= @from AND [t].[WorkDate] &lt; @to&#x0A;) AS [t0]&#x0A;GROUP BY [t0].[Key]" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090097EC2382B6A9BAB9ACECBFB12FAF15C30000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.240399" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA24F3994F39DD549" QueryPlanHash="0x212D07722528B023" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan CachedPlanSize="56" CompileTime="63" CompileCPU="9" CompileMemory="848"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="2