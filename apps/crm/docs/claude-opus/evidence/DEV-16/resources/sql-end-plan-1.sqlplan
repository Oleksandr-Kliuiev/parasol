<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4275.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="(@monthStart date,@monthEnd date)SELECT [s].[TechnicianId], [s].[Name], COALESCE(SUM(CASE&#x0A;    WHEN [s].[Classification] = N'Rate' THEN [s].[BilledHours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Billed], COALESCE(SUM(CASE&#x0A;    WHEN [s].[Classification] = N'Covered' THEN [s].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Covered], COALESCE(SUM(CASE&#x0A;    WHEN [s].[Classification] = N'HourBank' THEN [s].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Bank], COALESCE(SUM(CASE&#x0A;    WHEN [s].[Classification] = N'NonBillable' THEN [s].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [NonBillable]&#x0A;FROM (&#x0A;    SELECT [t].[BilledHours], [t].[Classification], [t].[Hours], [t1].[TechnicianId], COALESCE([t1].[TechnicianName], N'—') COLLATE Latin1_General_100_BIN2 AS [Name], DATALENGTH(COALESCE([t1].[TechnicianName], N'—')) AS [NameLength]&#x0A;    FROM [time].[TimeAllocations] AS [t]&#x0A;    INNER JOIN (&#x0A;        SELECT [t0].[Id], [t0].[TechnicianId], [t0].[TechnicianName], [t0].[WorkDate]&#x0A;        FROM [time].[TimeEntries] AS [t0]&#x0A;        WHERE [t0].[IsDeleted] = CAST(0 AS bit)&#x0A;    ) AS [t1] ON [t].[TimeEntryId] = [t1].[Id]&#x0A;    WHERE [t].[IsDeleted] = CAST(0 AS bit) AND [t1].[WorkDate] &gt;= @monthStart AND [t1].[WorkDate] &lt;= @monthEnd&#x0A;) AS [s]&#x0A;GROUP BY [s].[TechnicianId], [s].[Name], [s].[NameLength]" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900B8DF7916F2070B0196D814DC1B9B2F0E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="6.62385" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xEE5BE1D4CBE3959C" QueryPlanHash="0x877B71BCA13874C7" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan CachedPlanSize="104" CompileTime="207" CompileCPU="45" CompileMemory="1440"><ThreadStat Branches="1"/><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="4624" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="232640"/><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-04T21:29:13.89" ModificationCount="0" SamplingPercent="7.7319" Statistics="[PK_TimeAllocations]" Table="[TimeAllocations]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:39:52.36" ModificationCount="0" SamplingPercent="5.3283" Statistics="[_WA_Sys_0000000B_45BE5BA9]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.99" ModificationCount="0" SamplingPercent="8.23" Statistics="[IX_TimeAllocations_TimeEntryId]" Table="[TimeAllocations]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.56" ModificationCount="0" SamplingPercent="5.3283" Statistics="[PK_TimeEntries]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:39:54.37" ModificationCount="0" SamplingPercent="5.1417" Statistics="[_WA_Sys_00000007_45BE5BA9]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:39:52.67" ModificationCount="0" SamplingPercent="5.1417" Statistics="[_WA_Sys_00000020_45BE5BA9]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:52:57.49" Mod