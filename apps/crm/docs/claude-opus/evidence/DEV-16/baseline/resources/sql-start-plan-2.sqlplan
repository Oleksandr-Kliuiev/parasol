<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4275.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="&#x0A;      WITH CTE AS (&#x0A;      SELECT DISTINCT i.object_id oid, i.index_id iid&#x0A;      FROM sys.indexes i WITH(nolock)&#x0A;      JOIN sys.index_columns ic WITH(nolock) ON i.object_id = ic.object_id&#x0A;      JOIN sys.columns c WITH(nolock) ON ic.column_id = c.column_id AND c.object_id = i.object_id&#x0A;      WHERE c.system_type_id = 43 AND c.user_type_id = 43 -- only datetimeoffset columns&#x0A;      AND ic.key_ordinal != 0 -- only key columns&#x0A;      )&#x0A;      SELECT COUNT_BIG(*) AS [NumDatetimeoffsetCols], db_id() AS database_id&#x0A;      FROM CTE" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900C4E45F8187067E870F75132508075A230000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.120499" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3689CC7EAF602E4E" QueryPlanHash="0x02959D23246467A6" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan NonParallelPlanReason="NonParallelizableIntrinsicFunction" CachedPlanSize="96" CompileTime="39" CompileCPU="39" CompileMemory="4568"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="489296"/><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-04T21:25:31.11" ModificationCount="415" Sa