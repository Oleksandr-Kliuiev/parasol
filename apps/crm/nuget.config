<?xml version="1.0" encoding="utf-8"?>
<!-- DEV-21 (F-G5-16): one package source, named explicitly, and every package must come from it. <clear/> drops sources a
     developer or CI image adds globally; the mapping makes a second source an explicit, reviewed change instead of a
     silent one (dependency confusion). Lock files (packages.lock.json) are NOT enabled: see docs/06-security.md §4. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
