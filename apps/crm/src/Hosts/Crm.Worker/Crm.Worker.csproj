<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Shared by crm-web and crm-worker so integration keys are set once locally -->
    <UserSecretsId>vardahei-crm</UserSecretsId>
    <!-- dotnet publish -t:PublishContainer: distroless, non-root base image -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra</ContainerBaseImage>
    <ContainerRepository>crm-worker</ContainerRepository>
    <ContainerPort>8080</ContainerPort>
  </PropertyGroup>
  <ItemGroup>
    <!-- Local development settings (the sa connection string, the development sign-in) never travel with the image (F-G4-15). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.SqlServer" />
  </ItemGroup>
