// ---------------------------------------------------------------------------------------------------------------------
// Stage 4 PowerOffice MOCK (docs/stage4/03_DATA_AND_CONCURRENCY.md, migrations 202610091200/1210/1220). Every key and
// reference carries workspace, client and connection. CHECKs, lifecycle/history/retention guards, the strict aggregate
// validation, deferred commit invariants and ENABLE+FORCE RLS live in the migrations; grants and the restrictive
// maintenance policies in prisma/roles.sql. Only bounded aggregates and operational metadata are stored.
// ---------------------------------------------------------------------------------------------------------------------
/// One row per PowerOffice connection, created only by sync admission and never deleted. Operational pointers: the one
/// ACTIVE claim, the published snapshot (+ its lifecycle version), the latest allocated claim and the latest completed
/// outcome. lastSuccessAt equals the pointer's publishedAt while a pointer exists and survives its purge.
model PowerOfficeState {
  workspaceId            String
  clientId               String
  connectionId           String
  nextSequence           Int       @default(1)
  activeAttemptId        String?   @db.Uuid
  snapshotId             String?   @db.Uuid
  snapshotVersion        Int?
  lastAttemptId          String?   @db.Uuid
  lastAttemptState       String?
  lastAttemptErrorCode   String?
  lastCompletedAttemptId String?   @db.Uuid
  lastCompletedState     String?
  lastCompletedErrorCode String?
  lastSuccessAt          DateTime?
  updatedAt              DateTime  @default(now())
  connection             Connection           @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeState_connection_fkey")
  activeAttempt          PowerOfficeAttempt?  @relation("PowerOfficeStateActive", fields: [workspaceId, clientId, connectionId, activeAttemptId], references: [workspaceId, clientId, connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeState_active_fkey")
  lastAttempt            PowerOfficeAttempt?  @relation("PowerOfficeStateLast", fields: [workspaceId, clientId, connectionId, lastAttemptId], references: [workspaceId, clientId, connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeState_lastAttempt_fkey")
  lastCompletedAttempt   PowerOfficeAttempt?  @relation("PowerOfficeStateCompleted", fields: [workspaceId, clientId, connectionId, lastCompletedAttemptId], references: [workspaceId, clientId, connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeState_lastCompleted_fkey")
  snapshot               PowerOfficeSnapshot? @relation("PowerOfficeStateSnapshot", fields: [workspaceId, clientId, connectionId, snapshotId, snapshotVersion], references: [workspaceId, clientId, connectionId, id, lifecycleVersion], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeState_snapshot_fkey")
  attempts               PowerOfficeAttempt[] @relation("PowerOfficeAttemptState")
  @@id([workspaceId, clientId, connectionId])
}
/// One durable claim: immutable identity, private claim token, allocated snapshot ID, lifecycle version, actor and the exact
/// 60 s read / 80 s total deadlines from the DB startedAt. ACTIVE → SUCCEEDED | FAILED | ABANDONED, never revived.
model PowerOfficeAttempt {
  workspaceId         String
  clientId            String
  connectionId        String
  id                  String    @db.Uuid
  sequence            Int
  claimToken          String    @db.Uuid
  allocatedSnapshotId String    @db.Uuid
  lifecycleVersion    Int
  actorId             String
  correlationId       String    @db.Uuid
  startedAt           DateTime
  readDeadlineAt      DateTime
  deadlineAt          DateTime
  state               String    @default("ACTIVE")
  completedAt         DateTime?
  safeErrorCode       String?
  connection          Connection            @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeAttempt_connection_fkey")
  stateRow            PowerOfficeState      @relation("PowerOfficeAttemptState", fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, connectionId], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeAttempt_state_fkey")
  actor               Actor                 @relation(fields: [workspaceId, actorId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeAttempt_actor_fkey")
  snapshots           PowerOfficeSnapshot[]
  activeFor           PowerOfficeState[]    @relation("PowerOfficeStateActive")
  lastFor             PowerOfficeState[]    @relation("PowerOfficeStateLast")
  completedFor        PowerOfficeState[]    @relation("PowerOfficeStateCompleted")
  @@id([workspaceId, clientId, connectionId, id])
  @@unique([workspaceId, clientId, connectionId, sequence], map: "PowerOfficeAttempt_sequence_key")
  @@unique([workspaceId, clientId, connectionId, allocatedSnapshotId], map: "PowerOfficeAttempt_snapshot_key")
  @@unique([workspaceId, clientId, connectionId, id, allocatedSnapshotId, lifecycleVersion, startedAt], map: "PowerOfficeAttempt_publication_key")
  @@index([workspaceId, clientId, connectionId, completedAt], map: "PowerOfficeAttempt_retention_idx")
  @@index([workspaceId, actorId], map: "PowerOfficeAttempt_actor_idx")
}
/// Immutable complete published summary of one SUCCEEDED attempt: its allocated ID, lifecycle version, asOf = startedAt,
/// Europe/Oslo business date, publication time and 24 h expiry. summary is the exact bounded aggregate; synthetic marker.
model PowerOfficeSnapshot {
  workspaceId      String
  clientId         String
  connectionId     String
  id               String   @db.Uuid
  attemptId        String   @db.Uuid
  lifecycleVersion Int
  asOf             DateTime
  businessDate     DateTime @db.Date
  publishedAt      DateTime
  expiresAt        DateTime
  summary          Json
  synthetic        Boolean  @default(true)
  connection       Connection         @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeSnapshot_connection_fkey")
  attempt          PowerOfficeAttempt @relation(fields: [workspaceId, clientId, connectionId, attemptId, id, lifecycleVersion, asOf], references: [workspaceId, clientId, connectionId, id, allocatedSnapshotId, lifecycleVersion, startedAt], onDelete: Restrict, onUpdate: Restrict, map: "PowerOfficeSnapshot_attempt_fkey")
  pointerOf        PowerOfficeState[] @relation("PowerOfficeStateSnapshot")
  @@id([workspaceId, clientId, connectionId, id])
  @@unique([workspaceId, clientId, connectionId, attemptId], map: "PowerOfficeSnapshot_attempt_key")
  @@unique([workspaceId, clientId, connectionId, id, lifecycleVersion], map: "PowerOfficeSnapshot_version_key")
  @@index([workspaceId, clientId, connectionId, expiresAt, id], map: "PowerOfficeSnapshot_expiry_idx")
}
