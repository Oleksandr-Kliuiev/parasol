<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4275.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="(@from date,@to date)SELECT TOP(2) COUNT(*) AS [Count], COALESCE(SUM([t0].[Hours]), 0.0) AS [Hours], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Billable] = CAST(1 AS bit) THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Billable], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Status] IN (N'Approved', N'Invoiced') THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [Approved], COALESCE(SUM(CASE&#x0A;    WHEN [t0].[Status] = N'New' THEN [t0].[Hours]&#x0A;    ELSE 0.0&#x0A;END), 0.0) AS [New], COALESCE(SUM(COALESCE([t0].[Amount], 0.0)), 0.0) AS [Amount]&#x0A;FROM (&#x0A;    SELECT [t].[Amount], [t].[Billable], [t].[Hours], [t].[Status], 1 AS [Key]&#x0A;    FROM [time].[TimeEntries] AS [t]&#x0A;    WHERE [t].[IsDeleted] = CAST(0 AS bit) AND [t].[WorkDate] &gt;= @from AND [t].[WorkDate] &lt; @to&#x0A;) AS [t0]&#x0A;GROUP BY [t0].[Key]" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090097EC2382B6A9BAB9ACECBFB12FAF15C30000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="34.0326" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA24F3994F39DD549" QueryPlanHash="0x6D46DA223A6F8AC8" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan CachedPlanSize="80" CompileTime="147" CompileCPU="12" CompileMemory="840"><ThreadStat Branches="1"/><MissingIndexes><MissingIndexGroup Impact="85.5533"><MissingIndex Database="[crm_load_dev16_37cba9904feb]" Schema="[time]" Table="[TimeEntries]"><ColumnGroup Usage="EQUALITY"><Column Name="[IsDeleted]" ColumnId="32"/></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[WorkDate]" ColumnId="11"/></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[Hours]" ColumnId="14"/><Column Name="[Billable]" ColumnId="16"/><Column Name="[Status]" ColumnId="20"/><Column Name="[Amount]" ColumnId="22"/></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"/><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="27312"/><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-04T21:39:52.36" ModificationCount="0" SamplingPercent="5.3283" Statistics="[_WA_Sys_0000000B_45BE5BA9]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.56" ModificationCount="0" SamplingPercent="5.3283" Statistics="[PK_TimeEntries]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:39:52.67" ModificationCount="0" SamplingPercent="5.1417" Statistics="[_WA_Sys_00000020_45BE5BA9]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.81" ModificationCount="0" SamplingPercent="5.1417" Statistics="[IX_TimeEntries_Status_WorkDate]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.84" ModificationCount="0" SamplingPercent="5.1417" Statistics="[IX_TimeEntries_TechnicianId_WorkDate]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904feb]"/><StatisticsInfo LastUpdate="2026-10-04T21:29:13.66" ModificationCount="0" SamplingPercent="5.1417" Statistics="[IX_TimeEntries_OrganizationId_WorkDate]" Table="[TimeEntries]" Schema="[time]" Database="[crm_load_dev16_37cba9904