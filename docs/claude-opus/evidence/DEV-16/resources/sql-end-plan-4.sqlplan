<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4275.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="(@p int,@word_contains nvarchar(256),@domain nvarchar(4000),@word3_contains nvarchar(256),@domain5 nvarchar(4000),@term_Text_startswith nvarchar(256))SELECT TOP(@p) [o].[Id], [o].[Name], [o].[OrgNumber], [o].[VisitAddress_City] AS [VisitCity], [o].[PostalAddress_City] AS [PostalCity]&#x0A;FROM [customers].[Organizations] AS [o]&#x0A;WHERE [o].[IsDeleted] = CAST(0 AS bit) AND ([o].[Name] LIKE @word_contains ESCAPE N'\' OR ([o].[Email] IS NOT NULL AND [o].[Email] LIKE @word_contains ESCAPE N'\') OR @domain IN (&#x0A;    SELECT [d].[value]&#x0A;    FROM OPENJSON([o].[Domains]) WITH ([value] nvarchar(max) '$') AS [d]&#x0A;)) AND ([o].[Name] LIKE @word3_contains ESCAPE N'\' OR ([o].[Email] IS NOT NULL AND [o].[Email] LIKE @word3_contains ESCAPE N'\') OR @domain5 IN (&#x0A;    SELECT [d0].[value]&#x0A;    FROM OPENJSON([o].[Domains]) WITH ([value] nvarchar(max) '$') AS [d0]&#x0A;))&#x0A;ORDER BY CASE&#x0A;    WHEN [o].[Name] LIKE @term_Text_startswith ESCAPE N'\' THEN 0&#x0A;    ELSE 1&#x0A;END, [o].[Name]" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09003CD7DFBEE091145490A58AFD12E1E1430000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.360638" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x1AD451BDBBF982B2" QueryPlanHash="0x9CFA775887C1A75B" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"/><QueryPlan CachedPlanSize="88" CompileTime="58" CompileCPU="9" CompileMemory="