{
  "name": "vardahei-atlas-stage1-reference",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "schema:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node dist/apps/api/src/main.js",
    "api:smoke": "node --experimental-strip-types scripts/api-smoke.ts",
    "db:check:pg17": "node --experimental-strip-types scripts/pg17-check.ts",
    "db:check:drift": "node --experimental-strip-types scripts/schema-drift-check.ts",
    "test:pg": "npm run api:build && node --experimental-strip-types --test tests/pg/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
