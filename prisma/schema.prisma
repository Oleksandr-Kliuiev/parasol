// Explicitly pinned to Prisma ORM 6.19.0 (not latest Prisma 8 contract syntax).
// v1.1: CHECK constraints, partial unique indexes, append-only triggers and row-level security live in the migrations
// (Prisma 6 cannot express them). Apply with `prisma migrate deploy`; never regenerate an applied migration.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Workspace {
  id             String @id
  name           String
  clients        Client[]
  securityAudits SecurityAuditEvent[]
  actors         Actor[]
}
model Client {
  workspaceId String
  id          String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  entities    Entity[]
  connections Connection[]
  audits      AuditEvent[]
  executions  ToolExecution[]
  approvals   Approval[]
  memberships ClientMembership[]
  @@id([workspaceId, id])
}
/// Verified actor (technician or service). Permissions are per client (ClientMembership); workspacePermissions cover
/// MSP-wide reads such as the security audit. Read only through the authentication lookup policies (migration
/// 202610071600); written by the owner (synthetic seed) until an administration slice exists.
model Actor {
  workspaceId String
  id          String
  displayName String
  /// ACTIVE | DISABLED. Only ACTIVE actors authenticate.
  status      String @default("ACTIVE")
  /// Vocabulary fixed by a CHECK constraint: security_audit:read.
  workspacePermissions String[] @default([])
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  memberships ClientMembership[]
  tokens      ApiToken[]
  @@id([workspaceId, id])
}
model ClientMembership {
  workspaceId String
  clientId    String
  actorId     String
  /// Vocabulary fixed by a CHECK constraint: context:read, events:ingest, mapping:review, connections:manage.
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  actor       Actor @relation(fields: [workspaceId, actorId], references: [workspaceId, id], onDelete: Restrict)
  @@id([workspaceId, clientId, actorId])
  @@index([workspaceId, actorId])
}
/// Bearer API credential of an actor. Only the SHA-256 hex digest is stored (CHECK); the secret is never persisted.
model ApiToken {
  workspaceId String
  id          String
  actorId     String
  tokenHash   String @unique
  label       String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  actor       Actor @relation(fields: [workspaceId, actorId], references: [workspaceId, id], onDelete: Restrict)
  @@id([workspaceId, id])
  @@index([workspaceId, actorId])
}
model Entity {
  workspaceId String
  clientId    String
  id          String
  kind        String
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  person      Person?
  device      Device?
  links       EntityLink[]
  observations Observation[]
  @@id([workspaceId, clientId, id])
  /// Target of the typed link foreign key (migration 202610071700): a link names the kind it expects.
  @@unique([workspaceId, clientId, id, kind], map: "Entity_typed_key")
}
model Person {
  workspaceId String
  clientId    String
  id          String
  displayName String
  email       String?
  entity      Entity @relation(fields: [workspaceId, clientId, id], references: [workspaceId, clientId, id], onDelete: Restrict)
  devices     Device[]
  @@id([workspaceId, clientId, id])
  @@index([workspaceId, clientId, email])
}
model Device {
  workspaceId String
  clientId    String
  id          String
  hostname    String
  personId    String?
  entity      Entity @relation(fields: [workspaceId, clientId, id], references: [workspaceId, clientId, id], onDelete: Restrict)
  person      Person? @relation(fields: [workspaceId, clientId, personId], references: [workspaceId, clientId, id], onDelete: Restrict)
  @@id([workspaceId, clientId, id])
  @@index([workspaceId, clientId, hostname])
}
model Connection {
  workspaceId String
  clientId    String
  id          String
  system      String
  externalTenantId String
  secretRef   String
  /// DISABLED | FIXTURE | ACTIVE (CHECK). Only FIXTURE and ACTIVE connections resolve for reads.
  status      String @default("DISABLED")
  /// Explicit binding provenance: who mapped this client to the external customer/organization, and when. Required for
  /// ACTIVE (CHECK). The bound system/tenant and, once recorded, the provenance are immutable (trigger).
  boundBy     String?
  boundAt     DateTime?
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  entities    ExternalEntity[]
  events      RawEvent[]
  syncStates  SyncState[]
  @@id([workspaceId, clientId, id])
  @@unique([workspaceId, system, externalTenantId])
}
model ExternalEntity {
  workspaceId String
  clientId    String
  id          String
  connectionId String
  resourceType String
  externalId  String
  attributes  Json
  observedAt  DateTime
  connection  Connection @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict)
  links       EntityLink[]
  @@id([workspaceId, clientId, id])
  @@unique([workspaceId, clientId, connectionId, resourceType, externalId])
  /// Target of the typed link foreign key: a link names the resource type it expects.
  @@unique([workspaceId, clientId, id, resourceType], map: "ExternalEntity_typed_key")
}
model EntityLink {
  workspaceId String
  clientId    String
  id          String
  entityId    String
  externalEntityId String
  /// Carried by the link and pinned by the typed foreign keys; compatible pairs only: agent-DEVICE, contact-PERSON (CHECK).
  resourceType String
  entityKind  String
  /// CANDIDATE | CONFIRMED | REJECTED | QUARANTINED. One CONFIRMED per external entity (partial unique index).
  status      String @default("CANDIDATE")
  /// How the link was proposed: MANUAL, HOSTNAME_EXACT, FIXTURE. A hostname or name match never confirms by itself.
  method      String
  confidence  Float?
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  createdBy   String?
  /// Who decided (confirm, reject, revoke, quarantine) and when. Required for QUARANTINED (CHECK).
  reviewedBy  String?
  reviewedAt  DateTime?
  /// Code, never free text: CONFLICTS_WITH_CONFIRMED, MANUAL_REJECT, ...
  reasonCode  String?
  /// For a quarantined confirmation: the confirmed link of the SAME external entity it conflicts with.
  conflictsWithLinkId String?
  entity      Entity @relation(fields: [workspaceId, clientId, entityId, entityKind], references: [workspaceId, clientId, id, kind], onDelete: Restrict, onUpdate: Restrict, map: "EntityLink_entity_typed_fkey")
  external    ExternalEntity @relation(fields: [workspaceId, clientId, externalEntityId, resourceType], references: [workspaceId, clientId, id, resourceType], onDelete: Restrict, onUpdate: Restrict, map: "EntityLink_external_typed_fkey")
  conflictsWith EntityLink? @relation("EntityLinkConflict", fields: [workspaceId, clientId, externalEntityId, conflictsWithLinkId], references: [workspaceId, clientId, externalEntityId, id], onDelete: Restrict, onUpdate: Restrict, map: "EntityLink_conflictsWith_fkey")
  conflicts   EntityLink[] @relation("EntityLinkConflict")
  @@id([workspaceId, clientId, id])
  @@unique([workspaceId, clientId, externalEntityId, entityId])
  /// Foreign-key target of conflictsWithLinkId (same scope, same external entity).
  @@unique([workspaceId, clientId, externalEntityId, id], map: "EntityLink_external_link_key")
}
model RawEvent {
  workspaceId String
  clientId    String
  id          String
  connectionId String
  /// Type of the source object (alert, ticket, incident). Part of event identity: alert 123 and ticket 123 are different events.
  resourceType String
  externalEventId String
  revision    String
  /// SHA-256 of [eventKeyVersion, workspace, client, source, connection, resourceType, externalEventId, revision].
  eventKey    String @unique
  eventKeyVersion String @default("v2")
  normalized  Json
  payloadHash String
  occurredAt  DateTime
  receivedAt  DateTime @default(now())
  /// RECEIVED | PROCESSED | RETRY | DEAD_LETTER
  status      String @default("RECEIVED")
  attempts    Int @default(0)
  lastErrorCode String?
  /// Durable inbox (task 1.6): due time of the next attempt, lease of the worker holding it (owner, expiry and the claim's
  /// own token: all or none; none once PROCESSED or DEAD_LETTER), and the phase-1 decision reused by every retry of the
  /// final transaction. A worker changes the event only while its claim token is current (review B1).
  nextAttemptAt  DateTime @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  claimToken     String? @db.Uuid
  preparedDecision Json?
  /// Set on a redelivery with the same identity but different content: points at the canonical row, which is never overwritten.
  /// The link is scoped and identity-bound (same workspace, client, connection, resourceType, externalEventId, revision);
  /// one canonical row per identity (partial unique index) and "parent is canonical" (trigger) live in the migrations.
  conflictOfEventKey String?
  connection  Connection @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict)
  conflictOf  RawEvent? @relation("RawEventConflict", fields: [workspaceId, clientId, connectionId, resourceType, externalEventId, revision, conflictOfEventKey], references: [workspaceId, clientId, connectionId, resourceType, externalEventId, revision, eventKey], onDelete: Restrict, onUpdate: Restrict, map: "RawEvent_conflictOf_fkey")
  conflicts   RawEvent[] @relation("RawEventConflict")
  decisions   DecisionRun[]
  observation Observation?
  shadowJob   ShadowJob?
  @@id([workspaceId, clientId, id])
  @@unique([workspaceId, clientId, connectionId, resourceType, externalEventId, revision, payloadHash])
  /// Foreign-key target of the conflict link. Explicit map: Prisma's auto-generated name would collide with the unique above.
  @@unique([workspaceId, clientId, connectionId, resourceType, externalEventId, revision, eventKey], map: "RawEvent_identity_eventKey_key")
  @@index([workspaceId, clientId, status, receivedAt])
}
model DecisionRun {
  workspaceId String
  clientId    String
  id          String
  eventId     String
  provider    String
  /// fixture | rules | shadow | advisory
  mode        String @default("fixture")
  /// True for the one run whose route the observation uses. Shadow AI runs are stored with applied = false.
  applied     Boolean @default(false)
  /// Model requested from the provider and the identifier the provider returned. A mismatch is MODEL_MISMATCH, never silently accepted.
  requestedModel String?
  responseModel  String?
  promptVersion String
  inputHash   String
  status      String
  result      Json?
  latencyMs   Int?
  inputTokens Int?
  safeErrorCode String?
  /// Version of the decision configuration (config/decisions.json) the run was made under (task 1.7).
  configVersion String?
  createdAt   DateTime @default(now())
  event       RawEvent @relation(fields: [workspaceId, clientId, eventId], references: [workspaceId, clientId, id], onDelete: Restrict)
  observations Observation[]
  @@id([workspaceId, clientId, id])
  /// Target of the composite foreign key from Observation: the referenced run must belong to the same event and be applied.
  @@unique([workspaceId, clientId, id, eventId, applied])
  @@index([workspaceId, clientId, eventId])
}
/// Shadow mode (task 1.7): the AI call is a separate durable job, created in the baseline's final transaction and
/// claimed like the inbox (lease owner, expiry and claim token: all or none). Each provider call is a DecisionRun with
/// applied = false. PENDING | RETRY | DONE | FAILED | SKIPPED (CHECK); RETRY, FAILED and SKIPPED carry lastErrorCode.
model ShadowJob {
  workspaceId String
  clientId    String
  eventId     String
  configVersion String
  status      String @default("PENDING")
  attempts    Int @default(0)
  nextAttemptAt  DateTime @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  claimToken     String? @db.Uuid
  lastErrorCode  String?
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  event       RawEvent @relation(fields: [workspaceId, clientId, eventId], references: [workspaceId, clientId, id], onDelete: Restrict, map: "ShadowJob_event_fkey")
  @@id([workspaceId, clientId, eventId])
}
model Observation {
  workspaceId String
  clientId    String
  id          String
  eventId     String
  /// Canonical entity resolved at processing time through a CONFIRMED link; null when unresolved or conflicting.
  entityId    String?
  /// Applied DecisionRun. The composite key includes eventId and applied, so the run cannot belong to another event or
  /// client and cannot be a shadow (non-applied) run. decisionApplied is a constant true that carries `applied` into the key.
  decisionRunId String?
  decisionApplied Boolean @default(true)
  /// OPERATIONS | SECURITY (Stage 1: DISK_CAPACITY -> OPERATIONS, SECURITY_INCIDENT -> SECURITY)
  domain      String
  severity    String
  /// Numeric rank of severity for priority ordering. A CHECK constraint keeps it consistent with severity.
  severityRank Int
  /// NORMAL | URGENT, deterministic from source severity
  priority    String @default("NORMAL")
  route       String
  confidence  Float
  provider    String
  promptVersion String
  /// Every rule that influenced the result, in evaluation order.
  reasonCodes String[] @default([])
  /// OPEN | ACKNOWLEDGED | RESOLVED | SUPPRESSED. RESOLVED/SUPPRESSED need resolvedAt+resolvedBy unless legacyClosure.
  status      String @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  /// Closed before v1.1 without a recorded author/time. Set only by the v1.1 migration; a trigger rejects INSERTs with the
  /// flag and false → true UPDATEs from anyone, including the owner. Clearing it on reopen is allowed.
  legacyClosure Boolean @default(false)
  /// Lifecycle (task 1.8): who acknowledged and when (required for ACKNOWLEDGED, absent while OPEN); the newer observation
  /// of the same source object that superseded this one (only with SUPPRESSED). A trigger allows only the documented status
  /// changes and keeps the evidence (event, decision, entity, severity, priority, route, reasons) immutable.
  acknowledgedAt DateTime?
  acknowledgedBy String?
  supersededById String?
  supersededBy Observation? @relation("ObservationSupersede", fields: [workspaceId, clientId, supersededById], references: [workspaceId, clientId, id], onDelete: Restrict, onUpdate: Restrict, map: "Observation_supersededBy_fkey")
  supersedes  Observation[] @relation("ObservationSupersede")
  event       RawEvent @relation(fields: [workspaceId, clientId, eventId], references: [workspaceId, clientId, id], onDelete: Restrict)
  entity      Entity? @relation(fields: [workspaceId, clientId, entityId], references: [workspaceId, clientId, id], onDelete: Restrict)
  decisionRun DecisionRun? @relation(fields: [workspaceId, clientId, decisionRunId, eventId, decisionApplied], references: [workspaceId, clientId, id, eventId, applied], onDelete: Restrict, onUpdate: Restrict, map: "Observation_decisionRun_fkey")
  @@id([workspaceId, clientId, id])
  @@unique([workspaceId, clientId, eventId])
  @@index([workspaceId, clientId, status, severity])
  @@index([workspaceId, clientId, status, severityRank(sort: Desc), createdAt(sort: Desc), id])
}
model SyncState {
  workspaceId String
  clientId    String
  connectionId String
  resourceType String
  cursor      String?
  lastSyncAt  DateTime?
  lastSuccessAt DateTime?
  /// PENDING | OK | ERROR | UNAVAILABLE (CHECK). UNAVAILABLE: the source has no tenant-scoped read for this resource, so
  /// Atlas does not read it. ERROR and UNAVAILABLE carry safeErrorCode; lastSuccessAt never runs ahead of lastSyncAt.
  /// PENDING: the first attempt began and no outcome is recorded yet (no times, no code).
  status      String
  safeErrorCode String?
  /// Order of read attempts (review B3): the number last given to an attempt, and the number of the attempt whose outcome
  /// is recorded here. An outcome is recorded only if no attempt that began later has been recorded.
  attemptSeq  Int @default(0)
  recordedSeq Int @default(0)
  connection  Connection @relation(fields: [workspaceId, clientId, connectionId], references: [workspaceId, clientId, id], onDelete: Restrict)
  snapshot    ResourceSnapshot?
  @@id([workspaceId, clientId, connectionId, resourceType])
}
/// Last COMPLETE read of one live resource (alert, ticket, incident) of one connection (task 1.5). Replaced only together
/// with a SyncState success; a failed read keeps it. items: bounded projection (at most 100, CHECK), itemCount: source total.
model ResourceSnapshot {
  workspaceId String
  clientId    String
  connectionId String
  resourceType String
  asOf        DateTime
  items       Json
  itemCount   Int
  truncated   Boolean
  /// Vendor contract version the items were validated against (connectors/CONTRACTS.md).
  contractVersion String
  syncState   SyncState @relation(fields: [workspaceId, clientId, connectionId, resourceType], references: [workspaceId, clientId, connectionId, resourceType], onDelete: Restrict, map: "ResourceSnapshot_syncState_fkey")
  @@id([workspaceId, clientId, connectionId, resourceType])
}
/// Ledger of executed read tools (task 1.9), written with its client audit row: STARTED, then SUCCEEDED or FAILED
/// (safeErrorCode). Risk and side effect come from the registry; Stage 1 records read tools only (CHECK). inputHash is the
/// SHA-256 of the canonical validated input. A trigger lets a STARTED row record its outcome and nothing else.
model ToolExecution {
  workspaceId String
  clientId    String
  id          String
  actorId     String
  toolName    String
  toolVersion String
  riskLevel   Int
  sideEffect  String
  inputHash   String
  status      String
  correlationId String
  safeErrorCode String?
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  @@id([workspaceId, clientId, id])
  @@index([workspaceId, clientId, createdAt])
}
model AuditEvent {
  workspaceId String
  clientId    String
  id          String
  actorId     String
  eventType   String
  correlationId String
  metadata    Json
  recordedAt  DateTime @default(now())
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  @@id([workspaceId, clientId, id])
  @@index([workspaceId, clientId, recordedAt])
}
/// Workspace-level denial log. Scope and permission denials must not be written into a client's AuditEvent: the actor may
/// not be a member of that client, and the client may not exist. requestedClientId is plain text, never a foreign key.
/// Append-only by trigger, like AuditEvent.
model SecurityAuditEvent {
  workspaceId String
  id          String
  actorId     String
  eventType   String
  outcome     String @default("DENIED")
  requestedClientId String?
  reasonCode  String
  correlationId String
  metadata    Json
  recordedAt  DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  @@id([workspaceId, id])
  @@index([workspaceId, recordedAt])
}
// Reserved contract for a later write-action slice. No approval endpoints or actions in Stage 1.
model Approval {
  workspaceId String
  clientId    String
  id          String
  requestedBy String
  toolName    String
  toolVersion String
  canonicalInput Json
  inputHash   String
  riskLevel   Int
  status      String @default("PENDING")
  approvedBy  String?
  approvedAt  DateTime?
  expiresAt   DateTime
  consumedAt  DateTime?
  client      Client @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  @@id([workspaceId, clientId, id])
}
