# PostgreSQL local development only. Never use this password in a deployed environment.
# Owner connection: migrations (`prisma migrate deploy`) and the synthetic seed only. It bypasses row-level security.
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas
# Runtime connection for API and worker: the confined role from prisma/roles.sql (NOBYPASSRLS, not the owner).
# The application refuses to start through a role that bypasses RLS.
ATLAS_RUNTIME_DATABASE_URL=postgresql://atlas_app:replace-with-vault-value@localhost:5432/atlas
# Admin connection used only by `npm run db:check:pg17` (needs CREATEDB and CREATEROLE); it creates and drops a throwaway database.
ATLAS_PG_ADMIN_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas
# Reference demo uses fixtures; it never automatically contacts vendor APIs.
ATLAS_MODE=fixture
# Required by the loopback-only NestJS demo. Replace with your own local random token.
ATLAS_DEMO_TOKEN=
# Future live Decisions integration. Do not put credentials into prompts or reports.
OPENAI_API_KEY=
# Requested model and the exact response model identifiers accepted (comma-separated). No automatic suffix matching.
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_DECISIONS_ALLOWED_MODELS=gpt-6-luna
