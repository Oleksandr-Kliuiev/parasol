# PostgreSQL local development only. Never use this password in a deployed environment.
# Owner connection: migrations (`prisma migrate deploy`) and the synthetic seed only. It bypasses row-level security.
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas
# Runtime connection for API and worker: the confined role from prisma/roles.sql (NOBYPASSRLS, not the owner).
# The application refuses to start through a role that bypasses RLS.
ATLAS_RUNTIME_DATABASE_URL=postgresql://atlas_app:replace-with-vault-value@localhost:5432/atlas
# Admin connection used only by `npm run db:check:pg17`, `npm run test:pg` and `npm run db:check:drift` (needs CREATEDB and
# CREATEROLE); they create and drop throwaway databases and roles.
ATLAS_PG_ADMIN_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas
# API mode: fixture (synthetic in-memory reference) or db (PostgreSQL through ATLAS_RUNTIME_DATABASE_URL, actors from the
# database). Neither mode contacts vendor APIs. The API listens on 127.0.0.1 only; ATLAS_API_PORT defaults to 3100.
ATLAS_MODE=fixture
# Your own local random token (20+ characters of A-Z a-z 0-9 - . _ ~ + /). Fixture mode: the bearer token itself.
# DB mode: `npm run db:seed` stores only its SHA-256 digest for the synthetic demo actor; send it as the bearer token.
ATLAS_DEMO_TOKEN=
# Future live Decisions integration (modes shadow and advisory). Do not put credentials into prompts or reports.
OPENAI_API_KEY=
# Decision settings live in the versioned config/decisions.json. Optional overrides (leave empty to use the file as
# reviewed; an override that changes something marks the recorded configVersion with `-env`):
# mode fixture|rules|shadow|advisory — `rules` is the switch for a sustained provider outage
ATLAS_DECISIONS_MODE=
# Requested model and the exact response model identifiers accepted (comma-separated). No automatic suffix matching.
OPENAI_DECISIONS_MODEL=
OPENAI_DECISIONS_ALLOWED_MODELS=
