# Atlas production configuration template — names and allowed values only, never real values.
# Non-secret settings go to /etc/atlas-admin/atlas.env; secrets go to /etc/atlas-admin/secrets.env (0600 root).
# See docs/deploy/SECRETS_INVENTORY.md.
# Uncomment a line only with a valid value: several variables refuse to start on an empty string.

# --- /etc/atlas-admin/atlas.env (non-secret) ---
ATLAS_MODE=db
# ATLAS_API_PORT=<port bound to 127.0.0.1 behind the reverse proxy>
# ATLAS_OPERATOR_UI=0|1                 # unset/0 = off; 1 = on; empty refuses to start (apps/api/src/operator/console.ts)
# ATLAS_ASK_MODE=off|mock|remote        # remote only after the data/budget admission
# ATLAS_DECISIONS_MODE=<config/decisions.json mode>   # overrides pass the same validation
# OPENAI_DECISIONS_MODEL=<model>
# OPENAI_DECISIONS_ALLOWED_MODELS=<model,...>
# ATLAS_ACTIONS_MODE=MOCK               # unset = ACTION_MODE_DISABLED; LIVE is not implemented
# ATLAS_POWEROFFICE_MODE=MOCK           # unset = DISABLED; LIVE is not implemented
ATLAS_CORRELATION_CURSOR_SECRET_REF=env://ATLAS_CORRELATION_CURSOR_SECRET
ATLAS_M365_CLEANUP_RUNNER_SECRET_REF=env://ATLAS_M365_CLEANUP_RUNNER_URL
ATLAS_POWEROFFICE_CLEANUP_RUNNER_SECRET_REF=env://ATLAS_POWEROFFICE_CLEANUP_RUNNER_URL
# ATLAS_M365_CLEANUP_TIMEOUT_MS=300000  # 30000..600000

# --- /etc/atlas-admin/secrets.env (0600 root; generated on the server, never printed) ---
# ATLAS_RUNTIME_DATABASE_URL=
# ATLAS_CORRELATION_CURSOR_SECRET=      # >= 32 bytes
# ATLAS_M365_CLEANUP_RUNNER_URL=
# ATLAS_POWEROFFICE_CLEANUP_RUNNER_URL=

# --- /etc/atlas-admin/secrets.env (0600 root; entered by the owner: sudo atlas-admin-secret set NAME) ---
# Only after the matching live admission; the database stores env://NAME only.
# ATERA_<CLIENT>=                       # Atera API key (Bearer)
# HUNTRESS_<CLIENT>=                    # "<api key>:<api secret>"
# M365_<CLIENT>=                        # "<application id>:<client secret>"
# ATLAS_ASK_REMOTE_<NAME>=              # provider key, PENDING
# OPENAI_API_KEY=                       # Decisions, only when enabled

# Never set in production: ATLAS_POWEROFFICE_{LIVE,TENANT,CLIENT_KEY,APPLICATION_KEY,TOKEN,SECRET_REF,...} (refused at start),
# ATLAS_REVAL_* (local darwin R-EVAL only), ATLAS_DEMO_TOKEN / ATLAS_OPERATOR_TOKEN (synthetic development tokens).
