# Site block for the shared edge Caddy (/etc/atlas-edge/Caddyfile on the VPS; docs/deploy/DEPLOY.md).
# People: everything goes through oauth2-proxy (Microsoft sign-in); it injects the identity for the API.
# Machines: a request with its own bearer token goes straight to the API. Client-sent proxy credentials never reach the API:
# a Basic header is only ever produced by oauth2-proxy, and the bearer route forwards the client's own header unchanged.
admin.vardahei.tech {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Robots-Tag "noindex, nofollow"
	redir / /operator/ 302
	@bearer header Authorization "Bearer *"
	handle @bearer {
		reverse_proxy atlas-admin-api:3100
	}
	handle {
		reverse_proxy atlas-admin-oauth2:4180
	}
}
