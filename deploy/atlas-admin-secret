#!/bin/bash
# atlas-admin-secret — owner-run secret entry for Atlas (admin.vardahei.tech).
# The value is read with a hidden prompt and written to /etc/atlas-admin/secrets.env (root:root 0600). It never appears in argv,
# the environment of another process, shell history or any output. Only NAMES are ever printed.
#   sudo atlas-admin-secret set NAME     # hidden prompt, entered twice; replaces an existing NAME
#   sudo atlas-admin-secret unset NAME   # removes NAME
#   sudo atlas-admin-secret list         # names only
set -euo pipefail
umask 077
DIR=/etc/atlas-admin
FILE="$DIR/secrets.env"
usage() { echo "usage: sudo atlas-admin-secret set|unset NAME | list" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 1; }
cmd="${1:-}"; name="${2:-}"
valid_name() { [[ "$1" =~ ^[A-Z][A-Z0-9_]{0,99}$ ]]; }
install -d -m 0700 -o root -g root "$DIR"
[ -f "$FILE" ] || install -m 0600 -o root -g root /dev/null "$FILE"
rewrite_without() { # $1 = name; writes the file without that name into a new temp file and prints its path
  local tmp; tmp="$(mktemp "$DIR/.secrets.XXXXXX")"
  grep -v -E "^$1=" "$FILE" > "$tmp" || true
  printf '%s' "$tmp"
}
case "$cmd" in
  set)
    valid_name "$name" || { echo "NAME must match [A-Z][A-Z0-9_]*" >&2; exit 2; }
    [ -t 0 ] || { echo "an interactive terminal is required (ssh -t)" >&2; exit 2; }
    IFS= read -r -s -p "Value for $name (hidden): " v1; echo >&2
    IFS= read -r -s -p "Repeat: " v2; echo >&2
    [ -n "$v1" ] || { unset v1 v2; echo "empty value refused; nothing written" >&2; exit 3; }
    [ "$v1" = "$v2" ] || { unset v1 v2; echo "values differ; nothing written" >&2; exit 3; }
    tmp="$(rewrite_without "$name")"
    printf '%s=%s\n' "$name" "$v1" >> "$tmp"   # bash builtin: the value is never an argv of another process
    unset v1 v2
    chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$FILE"
    echo "OK $name set (value not shown)";;
  unset)
    valid_name "$name" || usage
    tmp="$(rewrite_without "$name")"; chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$FILE"
    echo "OK $name removed";;
  list)
    cut -d= -f1 "$FILE" | sort;;
  *) usage;;
esac
